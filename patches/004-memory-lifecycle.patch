+				void CBackendRepresentativeMemoryCache::queueFixedReaderRelease(CBackendRepresentativeMemoryCacheOntologyData* ontologyData) {
+					mPendingFixedReleasesMutex.lock();
+					mPendingFixedReleases.append(ontologyData);
+					KonPoolStats::gReaderReleasesQueued.fetch_add(1, std::memory_order_relaxed);
+					mPendingFixedReleasesMutex.unlock();
+				}
