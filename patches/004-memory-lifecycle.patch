+				void CBackendRepresentativeMemoryCache::drainFixedReaderReleases() {
+					QList<CBackendRepresentativeMemoryCacheOntologyData*> pending;
+					mPendingFixedReleasesMutex.lock();
+					pending.swap(mPendingFixedReleases);
+					mPendingFixedReleasesMutex.unlock();
+					if (pending.isEmpty()) {
+						return;
+					}
+					CMemoryPoolAllocationManager* memMan = mContext.getMemoryPoolAllocationManager();
+					for (CBackendRepresentativeMemoryCacheOntologyData* data : pending) {
+						data->decUsageCount();
+						KonPoolStats::gReaderReleasesDrained.fetch_add(1, std::memory_order_relaxed);
+						KonPoolStats::gReaderDrainLastUsage.store(data->getUsageCount(), std::memory_order_relaxed);
+						if (data->getUsageCount() <= 0) {
+							++mOntologyDataReleasedCount;
+							if (data->getRecomputationReferenceLinker()) {
+								data->getRecomputationReferenceLinker()->setOntologyDataInactive();
+							}
+							CBackendRepresentativeMemoryCacheOntologyContext* ontCtx = data->getOntologyContext();
+							if (ontCtx) {
+								CMemoryPool* ontCtxPools = ontCtx->getMemoryPoolContainer()->getMemoryPools();
+								if (ontCtxPools) {
+									memMan->releaseTemporaryMemoryPools(ontCtxPools);
+								}
+								delete ontCtx;
+							}
+							CMemoryPool* tmpPools = data->getTemporaryContext()->getMemoryPoolContainer()->getMemoryPools();
+							if (tmpPools) {
+								memMan->releaseTemporaryMemoryPools(tmpPools);
+							}
+							KonPoolStats::gOntDataFreed.fetch_add(1, std::memory_order_relaxed);
+							KonPoolStats::gOntDataReaderReleased.fetch_add(1, std::memory_order_relaxed);
+							delete data;
+						}
+					}
+				}
