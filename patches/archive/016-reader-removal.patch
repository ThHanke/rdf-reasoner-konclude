+				void CBackendRepresentativeMemoryCache::removeCacheReader(CBackendRepresentativeMemoryCacheReader* reader) {
+					if (!reader) return;
+					mReaderSyncMutex.lock();
+					if (mReaderLinker == reader) {
+						mReaderLinker = reader->getNext();
+					} else {
+						for (auto* it = mReaderLinker; it && it->getNext(); it = it->getNext()) {
+							if (it->getNext() == reader) {
+								it->setNext(reader->getNext());
+								break;
+							}
+						}
+					}
+					reader->setNext(nullptr);
+					int remaining = 0; for (auto* it = mReaderLinker; it; it = it->getNext()) ++remaining;
+					mReaderSyncMutex.unlock();
+					LOG(INFO,"::Konclude::WasmDebug",logTr("[READER-CLEANUP] removeCacheReader: remaining in mReaderLinker=%1").arg(remaining),this);
+				}
+
+				int CBackendRepresentativeMemoryCache::getReaderLinkerCount() {
+					mReaderSyncMutex.lock();
+					int count = 0; for (auto* it = mReaderLinker; it; it = it->getNext()) ++count;
+					mReaderSyncMutex.unlock();
+					return count;
+				}
+
+				void CBackendRepresentativeMemoryCache::clearAllLinkedReaders() {
+					mReaderSyncMutex.lock();
+					CBackendRepresentativeMemoryCacheReader* it = mReaderLinker;
+					mReaderLinker = nullptr;
+					mReaderSyncMutex.unlock();
+					int count = 0;
+					while (it) {
+						auto* next = it->getNext();
+						it->releaseAllSlots();
+						it->setNext(nullptr);
+						it = next;
+						++count;
+					}
+					LOG(INFO,"::Konclude::WasmDebug",logTr("[READER-CLEANUP] clearAllLinkedReaders: removed=%1 readers from mReaderLinker").arg(count),this);
+				}
+
