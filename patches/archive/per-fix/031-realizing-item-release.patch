+			CRealizerThread* CRealizerThread::releaseOntologyItems() {
+				QSet<COntologyRealizingItem*> items = mActiveOntItemSet;
+				items.unite(mInactiveOntItemSet);
+				mActiveOntItemSet.clear();
+				mInactiveOntItemSet.clear();
+				mProcessingOntItemList.clear();
+				mOntItemHash.clear();
+				for (COntologyRealizingItem* item : items) {
+					delete item;
+				}
+				return this;
+			}
