 							if (!negated) {
 								potentiallyModified |= closeOtherValueSpaces(indiProcNode,valueSpaceType,depTrackPoint,calcAlgContext);
 							} else {
-								potentiallyModified |= closeValueSpace(indiProcNode,valueSpaceType,depTrackPoint,calcAlgContext);
+								// WASM port: closing the whole value space is only the negation of a datatype that has no restrictions of its own (owl:real, xsd:string).
+								// A derived datatype (xsd:integer, xsd:positiveInteger, ...) carries its restrictions as operands; the datatype rule negates
