+			static bool isRoleInitializationSettled(COptimizedKPSetRoleInstancesItem* roleItem) {
+				return !roleItem->hasPendingInitializationTests() && (roleItem->isCandidateSuccessorInitializationCompleted() || !roleItem->hasToInitializeCandidatesFlag());
+			}
+
+			static bool areSubRolesInitializationSettled(COptimizedKPSetRoleInstancesItem* roleItem, QSet<COptimizedKPSetRoleInstancesItem*>& visited) {
+				for (const TRoleItemInversionPair& subPair : *roleItem->getSuccessorItemList()) {
+					COptimizedKPSetRoleInstancesItem* subItem = subPair.first;
+					if (!subItem || visited.contains(subItem)) {
+						continue;
+					}
+					visited.insert(subItem);
+					if (!isRoleInitializationSettled(subItem) || !areSubRolesInitializationSettled(subItem, visited)) {
+						return false;
+					}
+				}
+				return true;
+			}
