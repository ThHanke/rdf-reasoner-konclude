@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/> .

<http://example.org/data-properties-test> a owl:Ontology .

# ---------------------------------------------------------------------------
# Data property hierarchy: hasAge rdfs:subPropertyOf hasNumber
# ---------------------------------------------------------------------------

ex:hasAge    a owl:DatatypeProperty .
ex:hasNumber a owl:DatatypeProperty .
ex:hasAge rdfs:subPropertyOf ex:hasNumber .

# ---------------------------------------------------------------------------
# FunctionalProperty (data): hasSSN — each person has at most one SSN
# ---------------------------------------------------------------------------

ex:hasSSN a owl:DatatypeProperty, owl:FunctionalProperty .

# ---------------------------------------------------------------------------
# rdfs:range with datatype
# ---------------------------------------------------------------------------

ex:hasScore a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

# ---------------------------------------------------------------------------
# ABox: individual Alice with consistent data property usage
# ---------------------------------------------------------------------------

ex:Alice a owl:NamedIndividual ;
    ex:hasAge  "30"^^xsd:integer ;
    ex:hasSSN  "123-45-6789" ;
    ex:hasScore "95"^^xsd:integer .
