@prefix : <http://ex.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# expect: inconsistent
# A string literal as value of a property whose range is xsd:integer (cross-value-space clash).
:age a owl:DatatypeProperty ; rdfs:range xsd:integer .
:alice a owl:NamedIndividual ; :age "forty"^^xsd:string .
