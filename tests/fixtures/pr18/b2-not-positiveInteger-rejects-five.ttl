@prefix : <http://ex.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# expect: inconsistent
# Same ontology with 5, which is a positiveInteger and therefore outside the complement.
:p a owl:DatatypeProperty ; rdfs:range [ a rdfs:Datatype ; owl:datatypeComplementOf xsd:positiveInteger ] .
:a a owl:NamedIndividual ; :p "5"^^xsd:integer .
