<?xml version='1.0'?>
<!DOCTYPE Ontology>
<Ontology xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
          xml:base="http://example.org/reasoner-test"
          xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
          xmlns="http://www.w3.org/2002/07/owl#"
          xmlns:xml="http://www.w3.org/XML/1998/namespace"
          xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
          ontologyIRI="http://example.org/reasoner-test/case11">
 <Prefix name="" IRI="http://example.org/reasoner-test#"/>
 <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
 <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
 <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
 <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
 <Declaration><Class IRI="#Animal"/></Declaration>
 <Declaration><Class IRI="#Mammal"/></Declaration>
 <Declaration><Class IRI="#Fish"/></Declaration>
 <Declaration><NamedIndividual IRI="#nemo"/></Declaration>
 <!-- DisjointUnion: Animal = Mammal ⊔ Fish (disjoint union), so Mammal ∩ Fish = ∅ -->
 <!-- nemo is in both Mammal and Fish → inconsistent -->
 <DisjointUnion>
  <Class IRI="#Animal"/>
  <Class IRI="#Mammal"/>
  <Class IRI="#Fish"/>
 </DisjointUnion>
 <ClassAssertion>
  <Class IRI="#Mammal"/>
  <NamedIndividual IRI="#nemo"/>
 </ClassAssertion>
 <ClassAssertion>
  <Class IRI="#Fish"/>
  <NamedIndividual IRI="#nemo"/>
 </ClassAssertion>
</Ontology>
