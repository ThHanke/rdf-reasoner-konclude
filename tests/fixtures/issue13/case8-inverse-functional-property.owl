<?xml version='1.0'?>
<!DOCTYPE Ontology>
<Ontology xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
          xml:base="http://example.org/reasoner-test"
          xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
          xmlns="http://www.w3.org/2002/07/owl#"
          xmlns:xml="http://www.w3.org/XML/1998/namespace"
          xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
          ontologyIRI="http://example.org/reasoner-test/case8">
 <Prefix name="" IRI="http://example.org/reasoner-test#"/>
 <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
 <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
 <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
 <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
 <Declaration><ObjectProperty IRI="#hasMother"/></Declaration>
 <Declaration><NamedIndividual IRI="#alice"/></Declaration>
 <Declaration><NamedIndividual IRI="#bob"/></Declaration>
 <Declaration><NamedIndividual IRI="#eve"/></Declaration>
 <!-- InverseFunctionalProperty: at most one individual can have #hasMother pointing to eve -->
 <!-- alice hasMother eve, bob hasMother eve → alice sameAs bob -->
 <!-- But alice differentFrom bob → inconsistent -->
 <InverseFunctionalObjectProperty><ObjectProperty IRI="#hasMother"/></InverseFunctionalObjectProperty>
 <ObjectPropertyAssertion>
  <ObjectProperty IRI="#hasMother"/>
  <NamedIndividual IRI="#alice"/>
  <NamedIndividual IRI="#eve"/>
 </ObjectPropertyAssertion>
 <ObjectPropertyAssertion>
  <ObjectProperty IRI="#hasMother"/>
  <NamedIndividual IRI="#bob"/>
  <NamedIndividual IRI="#eve"/>
 </ObjectPropertyAssertion>
 <DifferentIndividuals>
  <NamedIndividual IRI="#alice"/>
  <NamedIndividual IRI="#bob"/>
 </DifferentIndividuals>
</Ontology>
