<?xml version='1.0'?>
<!DOCTYPE Ontology>
<Ontology xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
          xml:base="http://example.org/reasoner-test"
          xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
          xmlns="http://www.w3.org/2002/07/owl#"
          xmlns:xml="http://www.w3.org/XML/1998/namespace"
          xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
          ontologyIRI="http://example.org/reasoner-test/case10">
 <Prefix name="" IRI="http://example.org/reasoner-test#"/>
 <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
 <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
 <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
 <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
 <Declaration><ObjectProperty IRI="#p"/></Declaration>
 <Declaration><ObjectProperty IRI="#q"/></Declaration>
 <Declaration><NamedIndividual IRI="#alice"/></Declaration>
 <Declaration><NamedIndividual IRI="#bob"/></Declaration>
 <!-- p and q are disjoint AND equivalent → inconsistent when any triple exists -->
 <DisjointObjectProperties>
  <ObjectProperty IRI="#p"/>
  <ObjectProperty IRI="#q"/>
 </DisjointObjectProperties>
 <EquivalentObjectProperties>
  <ObjectProperty IRI="#p"/>
  <ObjectProperty IRI="#q"/>
 </EquivalentObjectProperties>
 <ObjectPropertyAssertion>
  <ObjectProperty IRI="#p"/>
  <NamedIndividual IRI="#alice"/>
  <NamedIndividual IRI="#bob"/>
 </ObjectPropertyAssertion>
</Ontology>
